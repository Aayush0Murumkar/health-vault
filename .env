# Server
PORT=3001

# JWT — change this to a long random string in production
JWT_SECRET=health_vault_super_secret_jwt_key_change_me

# JWT expiry
JWT_EXPIRES_IN=7d

# Max upload size in bytes (10 MB)
MAX_FILE_SIZE=10485760

# Allowed file MIME types (comma-separated)
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/jpg,image/webp

# SQLite database path
DB_PATH=./health_vault.db

# Frontend origin for CORS (adjust if frontend is served elsewhere)
CLIENT_ORIGIN=http://localhost:5500
